# -----------------------------------------------------------------------------
# Mon Petit Nuage — variables d'environnement
# Copier en .env.local pour le développement. Ne jamais committer .env.local.
# -----------------------------------------------------------------------------

# URL publique du site (sert aux metas, aux liens d'email et aux redirections Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : contourne la RLS. Serveur uniquement, jamais exposée au client.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers → API keys (mode test tant que le KYC n'est pas validé)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
# Obtenu via `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_

# Resend — emails transactionnels
RESEND_API_KEY=re_

# Signature des liens de suivi de commande envoyés aux clients invités.
# Générer avec : openssl rand -base64 48
ORDER_TOKEN_SECRET=

# Chromium local pour Playwright (conteneurs de développement uniquement)
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium
